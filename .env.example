# ============================================================================
# BridgeTalk — environment configuration TEMPLATE
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must NEVER be committed. This template must never contain real secrets.
#
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
# ============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Primary connection string used by SQLAlchemy (backend/app/database.py).
# MySQL 8.x / 9.x via PyMySQL:
DATABASE_URL=mysql+pymysql://bridgetalk:your_password_here@localhost:3306/bridgetalk

# For a quick demo with zero database setup, swap the line above for SQLite.
# This is the documented one-line fallback — nothing else in the code changes:
# DATABASE_URL=sqlite:///./bridgetalk.db

# ---------------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------------
# Generate a real secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# Server / CORS
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of origins allowed to call the API and open WebSockets.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Machine learning / real-time inference
# ---------------------------------------------------------------------------
# Paths are resolved relative to the repository root.
STATIC_MODEL_PATH=ml/models/static_model.keras
DYNAMIC_MODEL_PATH=ml/models/dynamic_model.keras
MODEL_METADATA_PATH=ml/models/metadata.json
LABELS_PATH=ml/models/labels.json

# Predictions below this softmax probability are ignored entirely (Section 9.3).
CONFIDENCE_THRESHOLD=0.80
# After a label is emitted, the same label is suppressed for this many ms.
COOLDOWN_MS=1500
# Majority-vote window: accept a label only if it wins MAJORITY_MIN of the last
# MAJORITY_WINDOW frames.
MAJORITY_WINDOW=10
MAJORITY_MIN=7
# Frames of `nothing` that close the current word.
NEUTRAL_RESET_FRAMES=8
# Rolling buffer length for the dynamic (LSTM) model.
SEQUENCE_LENGTH=30

# ---------------------------------------------------------------------------
# Frontend (Vite exposes only variables prefixed with VITE_)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
